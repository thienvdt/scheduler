{
  // Mở repo bằng GitHub Codespaces: tự cài, build rồi chạy app Lịch (8788) và app GVBM giả lập (8790).
  "name": "Lịch giảng",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "containerEnv": { "WRANGLER_SEND_METRICS": "false" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": {
    "app": "npm start",
    "demo": "npm run demo:import"
  },
  "forwardPorts": [8788, 8790],
  "portsAttributes": {
    "8788": { "label": "App Lịch", "onAutoForward": "openBrowser" },
    "8790": { "label": "App GVBM giả lập", "onAutoForward": "silent" }
  }
}
