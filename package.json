{
  "name": "scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-local.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-local.mjs",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "preview": "npm run build && node scripts/serve-static.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "demo:import": "node scripts/demo-import.mjs",
    "dev:cloudflare": "NEXT_PUBLIC_STORAGE=cloudflare next dev",
    "dev:api": "wrangler pages dev public --port 8788",
    "preview:cloudflare": "NEXT_PUBLIC_STORAGE=cloudflare npm run build && wrangler pages dev",
    "deploy": "NEXT_PUBLIC_STORAGE=cloudflare npm run build && wrangler pages deploy out",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/seed.sql",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "simulate:cloudflare": "node scripts/setup-cloudflare.mjs --simulate"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
